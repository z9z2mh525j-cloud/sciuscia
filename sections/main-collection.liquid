{%- comment -%} Pagina collezione (griglia prodotti) {%- endcomment -%}
<section class="pagina-testa">
  <div class="briciole"><a href="{{ routes.root_url }}">Home</a> / <span>{{ collection.title | default: 'Collezione' }}</span></div>
  <p class="kicker">{{ settings.kicker_collezione }}</p>
  <h1>{{ collection.title | default: 'Tutt''e ventaglie nuoste' }}</h1>
  {%- if collection.description != blank -%}
    <div class="pagina-intro rte">{{ collection.description }}</div>
  {%- endif -%}
</section>

<section class="collezione">
  <div class="griglia-prodotti">
    {%- paginate collection.products by 12 -%}
      {%- for product in collection.products -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        <p class="vuoto-filtro">Nun ce sta niente cca 'mmiezo… pe' mo'.</p>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>

  {%- paginate collection.products by 12 -%}
    {%- if paginate.pages > 1 -%}
      <div class="centro-azione paginazione">
        {%- if paginate.previous -%}<a class="btn btn-fantasma" href="{{ paginate.previous.url }}">← Precedente</a>{%- endif -%}
        {%- if paginate.next -%}<a class="btn btn-fantasma" href="{{ paginate.next.url }}">Successiva →</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Pagina collezione",
  "settings": []
}
{% endschema %}
