<section class="pagina-testa pagina-testa-stretta">
  <h1>'O tuo account</h1>
  <p class="pagina-intro">Ciao {{ customer.first_name | default: customer.email }} · <a href="{{ routes.account_logout_url }}" class="link-blu">Esci</a></p>
</section>

<div class="account-griglia">
  <div class="account-box">
    <h2>Ordini</h2>
    {%- paginate customer.orders by 12 -%}
      {%- if customer.orders.size > 0 -%}
        <table class="account-tabella">
          <thead><tr><th>Ordine</th><th>Data</th><th>Totale</th><th>Stato</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}" class="link-blu">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                <td>{{ order.total_price | money }}</td>
                <td>{{ order.financial_status_label }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p>Nun ce stanno ancora ordini.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  <div class="account-box">
    <h2>Indirizzo</h2>
    {%- if customer.default_address -%}
      <p class="rte">{{ customer.default_address | format_address }}</p>
    {%- endif -%}
    <a href="{{ routes.account_addresses_url }}" class="btn btn-fantasma">Gestisci indirizzi</a>
  </div>
</div>
