<section class="pagina-testa pagina-testa-stretta">
  <h1>Attiva 'o tuo account</h1>
</section>
<div class="auth-box">
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <label>Password <input type="password" name="customer[password]" required></label>
    <label>Conferma password <input type="password" name="customer[password_confirmation]" required></label>
    <button type="submit" class="btn btn-primario btn-block">Attiva account</button>
    <button type="submit" name="decline" class="btn btn-fantasma btn-block">Rifiuta invito</button>
  {%- endform -%}
</div>
