<section class="pagina-testa pagina-testa-stretta">
  <h1>Reimposta password</h1>
</section>
<div class="auth-box">
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label>Nuova password <input type="password" name="customer[password]" required></label>
    <label>Conferma password <input type="password" name="customer[password_confirmation]" required></label>
    <button type="submit" class="btn btn-primario btn-block">Reimposta</button>
  {%- endform -%}
</div>
